# Rename this file to .env and fill in your values
# Gmail requires an App Password (not your regular password):
#   Google Account → Security → 2FA → App Passwords → Generate

GMAIL_USER=you@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

FROM_NAME=Your Organization Name

# Optional: if you have a tracking server (e.g. free Flask on Railway)
# TRACKING_URL=https://your-server.up.railway.app/track
